# Normalize line endings to LF in the repository.
# On checkout, Windows will use CRLF (controlled by core.autocrlf=true),
# Linux/Mac will use LF. This prevents mixed-CRLF issues in git diff --check.

* text=auto eol=lf

# Explicitly binary files — never convert
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.pdf binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
*.zip binary
*.gz binary
